# ==============================================================================
# SpeakFlow Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Never commit real private keys or tokens to version control.
# - The React/Vite web application connects to the secure server boundary.
# - When running in standalone/offline mode, SpeakFlow uses LocalAdaptiveAIProvider
#   and deterministic speech abstractions without external dependencies.
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production
ALLOWED_ORIGIN=http://localhost:5173

# AI Intelligence Provider
# Options: 'local_adaptive' (default, offline-ready) | 'gemini' | 'openai'
AI_PROVIDER=local_adaptive

# Google Gemini API Configuration (Server-Side Only)
# Optional: Set this when deploying a production AI gateway.
# GEMINI_API_KEY=your_secure_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Speech & Privacy Configuration
ALLOW_VOICE_DATA_RETENTION=false
AUDIO_BUFFER_EXPIRY_MS=15000

# Client Web Feature Flags (Public, safe for browser)
VITE_ENABLE_CONVERSATION_MODE=true
VITE_OFFLINE_FALLBACK_MODE=true
